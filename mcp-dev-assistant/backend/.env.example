#环境变量模板
# ========= MySQL 数据库配置 =========
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DB=mcp_dev_assistant

# ========= 大模型LLM配置 支持DeepSeek / 通义千问（OpenAI兼容接口） =========
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-xxx_your_api_key_here
LLM_MODEL=deepseek-chat

# ========= Chroma 向量库存储路径 =========
CHROMA_PATH=./chroma_db

# ========= JWT登录鉴权配置 =========
JWT_SECRET_KEY=please_change_this_secret_key_123456
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120

# ========= MCP 运行参数 =========
MCP_TIMEOUT=30

# ========= 服务运行配置 =========
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
